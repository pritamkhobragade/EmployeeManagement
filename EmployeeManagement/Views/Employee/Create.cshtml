@model EmployeeManagement.Models.Employee

@{
    ViewBag.Title = "Create";
}


<h2>Add Employee</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(
        true,
        "",
        new { @class = "text-danger" }
    )

    <div class="row">

        <div class="col-md-6">

            <div class="form-group mb-3">
                @Html.LabelFor(x => x.Name)

                @Html.TextBoxFor(
                    x => x.Name,
                    new { @class = "form-control" }
                )

                @Html.ValidationMessageFor(
                    x => x.Name,
                    "",
                    new { @class = "text-danger" }
                )
            </div>


            <div class="form-group mb-3">
                @Html.LabelFor(x => x.Email)

                @Html.TextBoxFor(
                    x => x.Email,
                    new
                    {
                        @class = "form-control",
                        type = "email"
                    }
                )
            </div>


            <div class="form-group mb-3">
                @Html.LabelFor(x => x.Mobile)

                @Html.TextBoxFor(
                    x => x.Mobile,
                    new { @class = "form-control" }
                )
            </div>


            <div class="form-group mb-3">

                @Html.LabelFor(x => x.Gender)

                @Html.DropDownListFor(
                    x => x.Gender,
                    new SelectList(
                        new[]
                        {
                            "Male",
                            "Female",
                            "Other"
                        }
                    ),
                    "Select Gender",
                    new { @class = "form-control" }
                )

            </div>


            <div class="form-group mb-3">

                @Html.LabelFor(x => x.Age)

                @Html.TextBoxFor(
                    x => x.Age,
                    new
                    {
                        @class = "form-control",
                        type = "number"
                    }
                )

            </div>

        </div>


        <div class="col-md-6">

            <div class="form-group mb-3">

                @Html.LabelFor(x => x.Position)

                @Html.TextBoxFor(
                    x => x.Position,
                    new { @class = "form-control" }
                )

            </div>


            <div class="form-group mb-3">

                @Html.LabelFor(x => x.DepartmentId)

                @Html.DropDownList(
                    "DepartmentId",
                    null,
                    "Select Department",
                    new { @class = "form-control" }
                )

            </div>


            <div class="form-group mb-3">

                @Html.LabelFor(x => x.Salary)

                @Html.TextBoxFor(
                    x => x.Salary,
                    new
                    {
                        @class = "form-control",
                        type = "number"
                    }
                )

            </div>


            <div class="form-group mb-3">

                @Html.LabelFor(x => x.JoiningDate)

                @Html.TextBoxFor(
                    x => x.JoiningDate,
                    "{0:yyyy-MM-dd}",
                    new
                    {
                        @class = "form-control",
                        type = "date"
                    }
                )

            </div>


            <div class="form-group mb-3">

                @Html.LabelFor(x => x.Status)

                @Html.DropDownListFor(
                    x => x.Status,
                    new SelectList(
                        new[]
                        {
                            "Active",
                            "Inactive"
                        }
                    ),
                    "Select Status",
                    new { @class = "form-control" }
                )

            </div>

        </div>

    </div>


    <button type="submit"
            class="btn btn-success">
        Save Employee
    </button>

    <a href="@Url.Action("Index")"
       class="btn btn-secondary">
        Cancel
    </a>
}
