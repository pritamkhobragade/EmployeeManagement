@{
    Layout = null;
    ViewBag.Title = "Login - Employee Management";
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login - Employee Management</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link href="~/Content/login.css" rel="stylesheet" />
    
</head>

<body>

    <div class="page-wrap">

        <!-- Background -->
        <div class="grid-overlay"></div>

        <div class="orb a"></div>
        <div class="orb b"></div>
        <div class="orb c"></div>


        <div class="scene">

            <div class="login-card" id="card">

                <div class="glow"></div>


                <!-- HEADER -->

                <div class="login-header">

                    <div class="logo">

                        <svg viewBox="0 0 24 24">

                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />

                            <rect x="9"
                                  y="11"
                                  width="6"
                                  height="4"
                                  rx="1" />

                            <path d="M9.5 11V9a2.5 2.5 0 0 1 5 0v2" />

                        </svg>

                    </div>


                    <h1>Employee Management</h1>

                    <p>Sign in to your account</p>


                    <div class="secure-tag">

                        <svg viewBox="0 0 24 24">

                            <rect x="3"
                                  y="11"
                                  width="18"
                                  height="11"
                                  rx="2" />

                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />

                        </svg>

                        Secure &amp; encrypted connection

                    </div>

                </div>


                <!-- LOGIN FORM -->

                @using (Html.BeginForm(
                    "Login",
                    "Account",
                    FormMethod.Post,
                    new { id = "loginForm" }))
                {
                    @Html.AntiForgeryToken()


                    <!-- EMAIL -->

                    <div class="field">

                        <label for="email">
                            Email
                        </label>

                        <div class="input-wrap">

                            <svg class="ico"
                                 viewBox="0 0 24 24">

                                <rect x="2"
                                      y="4"
                                      width="20"
                                      height="16"
                                      rx="3" />

                                <path d="m2 7 10 7L22 7" />

                            </svg>


                            <input type="email"
                                   id="email"
                                   name="email"
                                   placeholder="Enter Email"
                                   autocomplete="username"
                                   required />

                        </div>

                    </div>


                    <!-- PASSWORD -->

                    <div class="field">

                        <label for="password">
                            Password
                        </label>

                        <div class="input-wrap">

                            <svg class="ico"
                                 viewBox="0 0 24 24">

                                <rect x="3"
                                      y="11"
                                      width="18"
                                      height="11"
                                      rx="3" />

                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />

                            </svg>


                            <input type="password"
                                   id="password"
                                   name="password"
                                   placeholder="Enter Password"
                                   autocomplete="current-password"
                                   required />


                            <!-- SHOW PASSWORD -->

                            <span class="eye"
                                  id="eye"
                                  title="Show/Hide Password">

                                <svg viewBox="0 0 24 24"
                                     id="eyeIcon">

                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />

                                    <circle cx="12"
                                            cy="12"
                                            r="3" />

                                </svg>

                            </span>

                        </div>

                    </div>


                    <!-- REMEMBER / FORGOT -->

                    <div class="login-row">

                        <label class="remember">

                            <input type="checkbox"
                                   name="rememberMe" />

                            Remember me

                        </label>


                        <a href="#" class="forgot">
                            Forgot password?
                        </a>

                    </div>


                    <!-- LOGIN BUTTON -->

                    <button type="submit"
                            class="login-btn"
                            id="btn">

                        <span id="btnState">
                            Sign in
                        </span>

                    </button>


                    <!-- ERROR -->

                    if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger login-error">

                            @ViewBag.Error

                        </div>
                    }

                }


                <!-- CORPORATE ACCOUNT -->

                <div class="divider">
                    <span>Employee Management System</span>
                </div>

                <!-- FOOTER -->

                
            </div>

        </div>

    </div>


    <!-- Custom JS -->
    <script src="~/Content/login.js"></script>

</body>
</html>