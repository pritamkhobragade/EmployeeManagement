
@{
    ViewBag.Title = "Index";
}


<div class="container-fluid">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                Employee Dashboard
            </h2>

            <p class="text-muted">
                Employee Management System
            </p>

        </div>


        <button id="refreshDashboard" class="btn btn-primary">
            Refresh
        </button>

    </div>


    <!-- Dashboard Cards -->

    <div class="row g-4">


        <!-- Total Employees -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-muted">
                                Total Employees
                            </h6>

                            <h2 id="totalEmployee" class="fw-bold">
                                0
                            </h2>

                        </div>
                        <div class="fs-1">
                            👨‍💼
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Departments -->

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>

                            <h6 class="text-muted">
                                Departments
                            </h6>

                            <h2 id="totalDepartments" class="fw-bold">
                                0
                            </h2>

                        </div>
                        <div class="fs-1">
                            🏢
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Active -->

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>

                            <h6 class="text-muted">
                                Active Employees
                            </h6>

                            <h2 id="activeEmployees" class="fw-bold text-success">
                                0
                            </h2>

                        </div>
                        <div class="fs-1">
                            ✅
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Inactive -->

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>

                            <h6 class="text-muted">
                                Inactive Employees
                            </h6>

                            <h2 id="inactiveEmployees" class="fw-bold text-danger">
                                0
                            </h2>

                        </div>
                        <div class="fs-1">
                            ⛔
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Second Row -->

    <div class="row g-4 mt-2">


        <!-- Total Salary -->

        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">
                        Total Salary
                    </h6>

                    <h2 id="totalSalary" class="fw-bold text-success">
                        ₹ 0
                    </h2>
                </div>
            </div>
        </div>


        <!-- Quick Actions -->

        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h5>
                        Quick Actions
                    </h5>

                    <div class="mt-3">

                        <a href="@Url.Action("Create","Employee")" class="btn btn-primary">
                            Add Employee
                        </a>

                        <a href="@Url.Action("Index", "Employee")" class="btn btn-outline-primary">
                            Employees
                        </a>

                        <a href="@Url.Action("Index", "Department")" class="btn btn-outline-secondary">
                            Departments
                        </a>

                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Employee Status -->

    <div class="row mt-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="mb-4">
                        Employee Status
                    </h5>

                    <!-- Active -->

                    <div class="d-flex justify-content-between">

                        <span>
                            Active Employees
                        </span>

                        <span id="activePercentage">
                            0%
                        </span>

                    </div>

                    <div class="progress mb-4" style="height: 25px;">

                        <div id="activeProgress" class="progress-bar bg-success" style="width: 0%;">
                            0%
                        </div>

                    </div>


                    <!-- Inactive -->

                    <div class="d-flex justify-content-between">

                        <span>
                            Inactive Employees
                        </span>

                        <span id="inactivePercentage">
                            0%
                        </span>

                    </div>


                    <div class="progress" style="height: 25px;">

                        <div id="inactiveProgress" class="progress-bar bg-danger" style="width: 0%;">
                            0%
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Loading -->

    <div id="loadingMessage" class="text-muted mt-3">
        Loading dashboard...
    </div>

</div>





